<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_surface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/widget_pulse_aura"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:alpha="0.4"
            android:contentDescription="@null"
            android:src="@drawable/widget_pulse_aura"
            android:visibility="gone" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/widget_camera_circle" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_create_story_title"
            android:src="@drawable/ic_widget_camera" />

        <ImageView
            android:id="@+id/widget_badge_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_badge_dot"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_create_story_title"
        android:textColor="@color/widget_brand_ink"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.7"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_create_story_subtitle"
        android:textColor="@color/widget_secondary_text"
        android:textSize="9sp" />
</LinearLayout>
